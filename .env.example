# Salin file ini jadi `.env` (sudah di-.gitignore — JANGAN commit .env asli).
# Backend advisory LLM — semua opsi GRATIS. Default tanpa file .env = template.

# Pilihan: template | ollama | groq | gemini
LLM_PROVIDER=template

# --- groq (rekomendasi utama demo: gratis, sangat cepat, butuh internet) ---
# Daftar & ambil key: https://console.groq.com  (free tier)
# GROQ_API_KEY=gsk_...
# GROQ_MODEL=llama-3.3-70b-versatile

# --- gemini (cadangan cloud gratis) ---
# Ambil key: https://aistudio.google.com/apikey  (free tier)
# GEMINI_API_KEY=AIza...
# GEMINI_MODEL=gemini-2.0-flash

# --- ollama (lokal, offline, gratis; install dari https://ollama.com) ---
# lalu: ollama pull qwen2.5:3b   (ringan utk laptop 16GB tanpa GPU; 7b lebih pintar tapi lambat)
# OLLAMA_MODEL=qwen2.5:3b
# OLLAMA_URL=http://localhost:11434

# --- openai (generik OpenAI-compatible — jalur DEPLOY pakai Qwen via cloud) ---
# OpenRouter (ada Qwen gratis): daftar https://openrouter.ai
#   LLM_PROVIDER=openai
#   OPENAI_BASE_URL=https://openrouter.ai/api/v1
#   OPENAI_API_KEY=sk-or-...
#   OPENAI_MODEL=qwen/qwen-2.5-7b-instruct:free
# DashScope/Alibaba (API resmi Qwen, ada kuota gratis):
#   OPENAI_BASE_URL=https://dashscope-intl.aliyuncs.com/compatible-mode/v1
#   OPENAI_MODEL=qwen2.5-7b-instruct
