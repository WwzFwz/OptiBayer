# Claude Code
.claude

# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
env/
.python-version

# Jupyter
.ipynb_checkpoints/

# Data hasil olahan (bisa diregenerasi dari data/raw + src/preprocess.py)
data/processed/*
!data/processed/.gitkeep

# Model terlatih (biasanya besar; metrics.json tetap di-track)
models/*.pkl
models/*.joblib
models/*.bin
models/*.ubj

# ...KECUALI surrogate yang harus ikut ke platform non-Docker.
# Jalur Docker melatihnya saat build (Dockerfile:35), jadi di sana artefak ini
# tidak dibutuhkan dan akan ditimpa. Tapi FastAPI Cloud membangun environment
# Python sendiri tanpa langkah training, dan tidak ada lagi jalur
# "latih-kalau-kosong" sejak app/main.py Streamlit dipensiunkan — tanpa berkas
# ini, semua endpoint prediksi gagal di produksi.
# Totalnya ~1,6 MB. Kalau kamu retrain, commit ulang hasilnya.
!models/surrogate_*.joblib

# IDE / OS
.vscode/
.idea/
.DS_Store
Thumbs.db

# Arsip kiriman tim di root (salinan resmi kalkulator ada di data/calculator/)
/*.zip
/*.xlsm

# Env & secrets
.env
*.local

# Streamlit
.streamlit/secrets.toml

# Frontend Next.js
frontend/node_modules/
frontend/.next/
frontend/out/
frontend/.env.local

# Docker
.dockerignore.local
